rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId) && (
        !('verificationTick' in request.resource.data) ||
        request.resource.data.verificationTick == 'green'
      );
      allow update: if (
        isOwner(userId) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationTick', 'isAdmin']) ||
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) &&
            (
              (!('verificationTick' in resource.data) && request.resource.data.verificationTick == 'green') ||
              (('verificationTick' in resource.data) && request.resource.data.verificationTick == resource.data.verificationTick)
            )
          )
        )
      ) || (
        isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      ) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followersUids', 'followersCount', 'updatedAt'])
      );
      allow delete: if isOwner(userId);

      match /callLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /follows/{edgeId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.followerUid == request.auth.uid;
    }

    match /duel_rooms/{pin} {
      allow read, create, update: if isAuth();
    }

    match /nudges/{nudgeId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.resource.data.fromUid == request.auth.uid;
    }

    match /friendships/{pairId} {
      allow read, write: if isAuth() && (
        request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB
      );
    }
  }
}
